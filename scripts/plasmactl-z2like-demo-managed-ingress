#!/usr/bin/env bash
set -Eeuo pipefail

managed_port="${PLASMA_Z2LIKE_DEMO_MANAGED_PORT:-18082}"
qemu_gateway_root="${PLASMA_Z2LIKE_DEMO_GATEWAY_ROOT:-http://172.30.77.2:18080}"
qemu_bootstrap_root="${PLASMA_Z2LIKE_DEMO_BOOTSTRAP_ROOT:-http://172.30.77.2:18081}"
nginx_conf="${PLASMA_Z2LIKE_DEMO_MANAGED_NGINX_CONF:-/etc/nginx/conf.d/plasma-z2like-demo-managed.conf}"
evidence="${PLASMA_Z2LIKE_DEMO_MANAGED_EVIDENCE:-/opt/plasma/install/z2like-demo-managed-ingress.json}"
marker="# Managed by Plasma z2like-demo QEMU managed programming ingress"
legacy_conf="${PLASMA_SWPC_Z2LIKE_MANAGED_NGINX_CONF:-/etc/nginx/conf.d/plasma-swpc-z2like-managed.conf}"
legacy_evidence="${PLASMA_SWPC_Z2LIKE_MANAGED_EVIDENCE:-/opt/plasma/install/swpc-z2like-managed-ingress.json}"
legacy_marker="# Managed by Plasma SWPC Z2-like managed programming ingress"
route_profile="managed-programming-v1"
bootstrap_route_profile="managed-bootstrap-v1"
bootstrap_prefix="/__plasma/bootstrap"

say() {
  printf '[plasmactl z2like-demo-managed] %s\n' "$*"
}

die() {
  printf '[plasmactl z2like-demo-managed] ERROR: %s\n' "$*" >&2
  exit 1
}

require_root() {
  (( EUID == 0 )) || die "$1 requires root; run with sudo"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

validate_contract() {
  [[ "$managed_port" =~ ^[0-9]+$ ]] || die "managed ingress port must be numeric: $managed_port"
  (( managed_port >= 1 && managed_port <= 65535 )) || die "managed ingress port is out of range: $managed_port"
  for reserved in 9900 18080 18081; do
    (( managed_port != reserved )) || die "managed ingress port conflicts with reserved Plasma port: $managed_port"
  done
  [[ "$qemu_gateway_root" =~ ^http://[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:18080$ ]] || \
    die "QEMU Gateway root must be a private IPv4 HTTP :18080 origin: $qemu_gateway_root"
  [[ "$qemu_bootstrap_root" =~ ^http://[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:18081$ ]] || \
    die "QEMU Bootstrap root must be a private IPv4 HTTP :18081 origin: $qemu_bootstrap_root"
  [[ "$qemu_gateway_root" != "http://127.0.0.1:18080" ]] || \
    die "z2like-demo managed ingress must not target the SWPC x86_64 surrogate Gateway"
  [[ "$qemu_bootstrap_root" != "http://127.0.0.1:18081" ]] || \
    die "z2like-demo managed ingress must not target the SWPC host diagnostics :18081"
  local gateway_host bootstrap_host
  gateway_host="${qemu_gateway_root#http://}"
  gateway_host="${gateway_host%:18080}"
  bootstrap_host="${qemu_bootstrap_root#http://}"
  bootstrap_host="${bootstrap_host%:18081}"
  [[ "$gateway_host" == "$bootstrap_host" ]] || \
    die "QEMU Gateway and Bootstrap roots must identify the same simulated Z2 host"
}

render_nginx() {
  cat <<EOF
$marker
# Public exposure is permitted only through the existing Cloudflare Access
# service-token protected ppu-managed-lab hostname. This listener is loopback-only.
# Product Gateway and Bootstrap remain separate QEMU services; only the exact
# Manager-owned Bootstrap API allowlist below is projected through a fixed prefix.
server {
    listen 127.0.0.1:$managed_port;
    server_name _;

    client_max_body_size 24m;
    proxy_http_version 1.1;
    proxy_read_timeout 125s;
    proxy_send_timeout 125s;
    proxy_set_header Host \$host;
    proxy_set_header X-Forwarded-Proto https;

    location = /api/health/live {
        limit_except GET { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location = /api/health/ready {
        limit_except GET { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location = /api/node {
        limit_except GET { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location = /api/status {
        limit_except GET { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location = /api/security/me {
        limit_except GET { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location = /api/devices/search {
        limit_except GET { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location = /api/engineering/targets {
        limit_except GET { deny all; }
        proxy_pass $qemu_gateway_root;
    }

    location = /api/settings/gateway {
        limit_except GET { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location = /api/settings/ppu-network {
        limit_except GET { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location = /api/settings/sites {
        limit_except GET { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location = /api/settings/sites/activation {
        limit_except POST { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location ~ ^/api/settings/sites/[1-9][0-9]*$ {
        limit_except POST { deny all; }
        proxy_pass $qemu_gateway_root;
    }

    location = /api/mock/runtime {
        limit_except GET POST { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location = /api/engineering/diagnostics/loopback {
        limit_except POST { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location = /api/engineering/session {
        limit_except POST { deny all; }
        proxy_pass $qemu_gateway_root;
    }

    location = /api/jobs {
        limit_except POST { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location ~ ^/api/jobs/[^/]+/cancel$ {
        limit_except POST { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location ~ ^/api/jobs/[^/]+/files/[^/]+$ {
        limit_except GET { deny all; }
        proxy_pass $qemu_gateway_root;
    }

    location = /api/batches {
        limit_except POST { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location ~ ^/api/batches/[^/]+$ {
        limit_except GET { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location ~ ^/api/batches/[^/]+/cancel$ {
        limit_except POST { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location ~ ^/api/batches/[^/]+/targets/[^/]+/[^/]+/cancel$ {
        limit_except POST { deny all; }
        proxy_pass $qemu_gateway_root;
    }

    location ~ ^/api/engineering/targets/[^/]+/[^/]+/api/status$ {
        limit_except GET { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location ~ ^/api/engineering/targets/[^/]+/[^/]+/api/programming-assets/check$ {
        limit_except POST { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location ~ ^/api/engineering/targets/[^/]+/[^/]+/api/programming-assets$ {
        limit_except POST { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location ~ ^/api/engineering/targets/[^/]+/[^/]+/api/jobs$ {
        limit_except POST { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location ~ ^/api/engineering/targets/[^/]+/[^/]+/api/jobs/[^/]+/cancel$ {
        limit_except POST { deny all; }
        proxy_pass $qemu_gateway_root;
    }
    location ~ ^/api/engineering/targets/[^/]+/[^/]+/api/jobs/[^/]+/files/[^/]+$ {
        limit_except GET { deny all; }
        proxy_pass $qemu_gateway_root;
    }

    # Controlled Manager -> Bootstrap maintenance projection. There is no
    # generic /v1/* or direct :18081 public route.
    location = $bootstrap_prefix/v1/status {
        limit_except GET { deny all; }
        proxy_pass $qemu_bootstrap_root/v1/status;
    }
    location = $bootstrap_prefix/v1/uploads {
        limit_except POST { deny all; }
        proxy_pass $qemu_bootstrap_root/v1/uploads;
    }
    location ~ ^$bootstrap_prefix/v1/uploads/[0-9a-f]{32}/chunks$ {
        limit_except POST { deny all; }
        rewrite ^$bootstrap_prefix(/.*)$ \$1 break;
        proxy_pass $qemu_bootstrap_root;
    }
    location ~ ^$bootstrap_prefix/v1/uploads/[0-9a-f]{32}/commit$ {
        limit_except POST { deny all; }
        rewrite ^$bootstrap_prefix(/.*)$ \$1 break;
        proxy_pass $qemu_bootstrap_root;
    }
    location = $bootstrap_prefix/v1/deployments {
        limit_except POST { deny all; }
        proxy_pass $qemu_bootstrap_root/v1/deployments;
    }

    # Deliberately excluded:
    # - /api/settings/ppu-network/activation*
    # - POST /api/settings/ppu-network
    # - POST /api/settings/gateway
    # - arbitrary /api/* paths
    # - arbitrary Bootstrap /v1/* paths
    # - direct public access to QEMU/SWPC :18081
    location / { return 404; }
}
EOF
}

verify_json_ready() {
  python3 -c '
import json, sys
payload = json.load(sys.stdin)
if payload.get("ok") is not True or payload.get("execution") != "ready":
    raise SystemExit(f"unexpected readiness payload: {payload!r}")
'
}

verify_bootstrap_ready() {
  python3 -c '
import json, sys
payload = json.load(sys.stdin)
bootstrap = payload.get("bootstrap")
if not isinstance(bootstrap, dict) or bootstrap.get("state") != "bootstrap_ready":
    raise SystemExit(f"unexpected Bootstrap status payload: {payload!r}")
'
}

verify_profile() {
  require_command curl
  require_command nginx
  require_command python3
  require_command ss
  validate_contract
  [[ -f "$nginx_conf" ]] || die "z2like-demo managed Nginx ingress is missing: $nginx_conf"
  grep -Fxq "$marker" "$nginx_conf" || die "z2like-demo managed Nginx ingress is not Plasma-owned"
  [[ ! -e "$legacy_conf" ]] || die "legacy SWPC x86 managed ingress still owns port $managed_port: $legacy_conf"
  nginx -t >/dev/null

  local listeners ready bootstrap_status sites_status gateway_post network_post blocked_activation blocked_unknown blocked_bootstrap method_blocked bootstrap_method_blocked
  listeners="$(ss -H -ltn "sport = :$managed_port")"
  [[ -n "$listeners" ]] || die "z2like-demo managed ingress is not listening on port $managed_port"
  while IFS= read -r line; do
    [[ "$line" == *"127.0.0.1:$managed_port"* ]] || die "managed ingress is not loopback-only: $line"
  done <<<"$listeners"

  ready="$(curl --noproxy '*' --fail --silent --show-error --max-time 5 \
    "http://127.0.0.1:$managed_port/api/health/ready")"
  verify_json_ready <<<"$ready"

  bootstrap_status="$(curl --noproxy '*' --fail --silent --show-error --max-time 5 \
    "http://127.0.0.1:$managed_port$bootstrap_prefix/v1/status")"
  verify_bootstrap_ready <<<"$bootstrap_status"

  sites_status="$(curl --noproxy '*' --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 5 \
    "http://127.0.0.1:$managed_port/api/settings/sites")"
  [[ "$sites_status" == "200" ]] || die "managed Site Desired read is unavailable: HTTP $sites_status"

  gateway_post="$(curl --noproxy '*' --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 5 \
    -X POST -H 'Content-Type: application/json' --data '{}' \
    "http://127.0.0.1:$managed_port/api/settings/gateway")"
  [[ "$gateway_post" == "403" ]] || die "managed ingress unexpectedly allowed Gateway settings mutation: HTTP $gateway_post"

  network_post="$(curl --noproxy '*' --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 5 \
    -X POST -H 'Content-Type: application/json' --data '{}' \
    "http://127.0.0.1:$managed_port/api/settings/ppu-network")"
  [[ "$network_post" == "403" ]] || die "managed ingress unexpectedly allowed PPU network mutation: HTTP $network_post"

  blocked_activation="$(curl --noproxy '*' --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 5 \
    "http://127.0.0.1:$managed_port/api/settings/ppu-network/activation")"
  [[ "$blocked_activation" == "404" ]] || die "managed ingress unexpectedly exposed PPU network activation: HTTP $blocked_activation"

  blocked_unknown="$(curl --noproxy '*' --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 5 \
    "http://127.0.0.1:$managed_port/api/not-allowlisted")"
  [[ "$blocked_unknown" == "404" ]] || die "managed ingress unexpectedly exposed an unknown API path: HTTP $blocked_unknown"

  blocked_bootstrap="$(curl --noproxy '*' --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 5 \
    "http://127.0.0.1:$managed_port$bootstrap_prefix/v1/not-allowlisted")"
  [[ "$blocked_bootstrap" == "404" ]] || die "managed ingress unexpectedly exposed an unknown Bootstrap path: HTTP $blocked_bootstrap"

  method_blocked="$(curl --noproxy '*' --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 5 \
    "http://127.0.0.1:$managed_port/api/jobs")"
  [[ "$method_blocked" == "403" ]] || die "managed ingress did not reject GET /api/jobs: HTTP $method_blocked"

  bootstrap_method_blocked="$(curl --noproxy '*' --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 5 \
    -X POST -H 'Content-Type: application/json' --data '{}' \
    "http://127.0.0.1:$managed_port$bootstrap_prefix/v1/status")"
  [[ "$bootstrap_method_blocked" == "403" ]] || die "managed ingress did not reject POST Bootstrap status: HTTP $bootstrap_method_blocked"

  say "PASS: ppu-managed-lab host ingress is bound to the QEMU ARMv7 Gateway and allowlisted Bootstrap maintenance path"
  say "edge-auth boundary: Cloudflare Access service token remains REQUIRED"
  say "bootstrap boundary: fixed prefix/method allowlist only; no generic or direct :18081 exposure"
  say "qualification boundary: simulation/software only; no physical Z2/PL/Site/IC claim"
}

write_evidence() {
  local source_sha
  source_sha="$(git -C "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" rev-parse HEAD 2>/dev/null || true)"
  install -d -m 0755 "$(dirname "$evidence")"
  cat >"$evidence" <<EOF
{
  "schema_version": 1,
  "role": "z2like-demo-managed-programming-ingress",
  "listen": "127.0.0.1:$managed_port",
  "upstream_gateway": "${qemu_gateway_root#http://}",
  "upstream_bootstrap": "${qemu_bootstrap_root#http://}",
  "backend": "QEMU ARMv7 simulated Z2",
  "route_profile": "$route_profile",
  "bootstrap_route_profile": "$bootstrap_route_profile",
  "bootstrap_public_prefix": "$bootstrap_prefix",
  "edge_auth_required": "cloudflare-access-service-token",
  "source_git_sha": "$source_sha",
  "hardware_boundary": "closed"
}
EOF
  chmod 0644 "$evidence"
}

install_profile() {
  require_root install
  require_command curl
  require_command nginx
  require_command python3
  require_command ss
  validate_contract

  if [[ -e "$nginx_conf" ]] && ! grep -Fxq "$marker" "$nginx_conf"; then
    die "refusing to overwrite unmanaged Nginx config: $nginx_conf"
  fi

  local legacy_present=0
  if [[ -e "$legacy_conf" || -e "$legacy_evidence" ]]; then
    [[ -f "$legacy_conf" && -f "$legacy_evidence" ]] || \
      die "legacy managed ingress state is incomplete; config/evidence must exist together"
    grep -Fxq "$legacy_marker" "$legacy_conf" || \
      die "refusing to migrate non-Plasma legacy Nginx config: $legacy_conf"
    legacy_present=1
  fi

  if [[ ! -e "$nginx_conf" && $legacy_present -eq 0 ]] && ss -H -ltn "sport = :$managed_port" | grep -q .; then
    die "managed ingress port is already in use by an unknown owner: $managed_port"
  fi

  local backup tmp_conf
  backup="$(mktemp -d /tmp/plasma-z2like-demo-ingress.XXXXXX)"
  [[ -f "$nginx_conf" ]] && cp -a "$nginx_conf" "$backup/new.conf"
  [[ -f "$evidence" ]] && cp -a "$evidence" "$backup/new.evidence"
  [[ -f "$legacy_conf" ]] && cp -a "$legacy_conf" "$backup/legacy.conf"
  [[ -f "$legacy_evidence" ]] && cp -a "$legacy_evidence" "$backup/legacy.evidence"

  rollback() {
    local rc=$?
    trap - ERR
    set +e
    rm -f "$nginx_conf" "$evidence" "$legacy_conf" "$legacy_evidence"
    [[ -f "$backup/new.conf" ]] && cp -a "$backup/new.conf" "$nginx_conf"
    [[ -f "$backup/new.evidence" ]] && cp -a "$backup/new.evidence" "$evidence"
    [[ -f "$backup/legacy.conf" ]] && cp -a "$backup/legacy.conf" "$legacy_conf"
    [[ -f "$backup/legacy.evidence" ]] && cp -a "$backup/legacy.evidence" "$legacy_evidence"
    nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1
    rm -rf "$backup"
    exit "$rc"
  }
  trap rollback ERR

  tmp_conf="$(mktemp "$(dirname "$nginx_conf")/.plasma-z2like-demo-managed.XXXXXX")"
  render_nginx >"$tmp_conf"
  chmod 0644 "$tmp_conf"
  chown root:root "$tmp_conf"
  rm -f "$legacy_conf" "$legacy_evidence"
  mv -f "$tmp_conf" "$nginx_conf"

  nginx -t
  systemctl reload nginx
  verify_profile
  write_evidence
  trap - ERR
  rm -rf "$backup"
  say "installed z2like-demo managed ingress: 127.0.0.1:$managed_port -> Gateway $qemu_gateway_root + Bootstrap allowlist $qemu_bootstrap_root"
}

remove_profile() {
  require_root remove
  require_command nginx
  [[ -f "$nginx_conf" ]] || die "z2like-demo managed ingress is not installed"
  grep -Fxq "$marker" "$nginx_conf" || die "refusing to remove unmanaged Nginx config: $nginx_conf"
  rm -f "$nginx_conf" "$evidence"
  nginx -t
  systemctl reload nginx
  say "removed z2like-demo managed ingress"
}

status_profile() {
  validate_contract
  printf 'Profile:        z2like-demo-managed-programming\n'
  printf 'Listen:         127.0.0.1:%s\n' "$managed_port"
  printf 'Gateway:        %s\n' "$qemu_gateway_root"
  printf 'Bootstrap:      %s via %s\n' "$qemu_bootstrap_root" "$bootstrap_prefix"
  printf 'Public owner:   ppu-managed-lab.open4th.com (external Cloudflare route)\n'
  printf 'Route profile:  %s\n' "$route_profile"
  printf 'Bootstrap path: %s\n' "$bootstrap_route_profile"
  printf 'Edge auth:      Cloudflare Access service token REQUIRED\n'
  printf 'Hardware:       CLOSED\n'
  if [[ -f "$evidence" ]]; then
    printf 'Evidence:       %s\n' "$evidence"
  else
    printf 'Evidence:       not-installed\n'
  fi
}

usage() {
  cat <<'EOF'
Usage: plasmactl-z2like-demo-managed-ingress COMMAND

Commands:
  install   Atomically migrate port 18082 from the legacy x86 ingress to QEMU
  verify    Validate loopback binding, QEMU Gateway/Bootstrap readiness and bounded route allowlists
  status    Show managed-ingress ownership
  remove    Remove only the Plasma-owned z2like-demo managed ingress

This command does not create or change Cloudflare DNS/Tunnel/Access state.
The existing ppu-managed-lab.open4th.com route is expected to continue targeting
SWPC 127.0.0.1:18082. Product Gateway traffic remains on QEMU :18080. Only the
fixed /__plasma/bootstrap Manager maintenance allowlist is mapped to QEMU :18081.
The SWPC host 18081 diagnostics ingress is untouched.
EOF
}

command="${1:-help}"
case "$command" in
  install) install_profile ;;
  verify) verify_profile ;;
  status) status_profile ;;
  remove) remove_profile ;;
  help|-h|--help) usage ;;
  *) usage >&2; die "unknown command: $command" ;;
esac
