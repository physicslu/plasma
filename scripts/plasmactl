#!/usr/bin/env bash
set -Eeuo pipefail

script_path="$(readlink -f "${BASH_SOURCE[0]}")"
default_repo="$(cd "$(dirname "$script_path")/.." && pwd)"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
config_file="${PLASMACTL_CONFIG:-$config_home/plasma/plasmactl.env}"
current_config_version=4
default_public_api_url="https://plasma.open4th.com"
default_manager_config="$config_home/plasma/manager.yaml"

if [[ -f "$config_file" ]]; then
  # shellcheck source=/dev/null
  source "$config_file"
fi

repo="${PLASMA_REPO:-$default_repo}"
branch="${PLASMA_BRANCH:-main}"
python_dir="$repo/software/python"
web_dir="$repo/software/web"
python_bin="${PLASMA_PYTHON:-$python_dir/.venv/bin/python}"
npm_bin="${PLASMA_NPM:-$(command -v npm 2>/dev/null || true)}"
uv_bin="${PLASMA_UV:-$(command -v uv 2>/dev/null || true)}"
if [[ -z "$uv_bin" && -x "$HOME/.local/bin/uv" ]]; then
  uv_bin="$HOME/.local/bin/uv"
fi
if [[ -n "$npm_bin" ]]; then
  export PATH="$(dirname "$npm_bin"):$PATH"
fi
gateway_host="${PLASMA_GATEWAY_HOST:-0.0.0.0}"
gateway_port="${PLASMA_GATEWAY_PORT:-18080}"
cors_origin="${PLASMA_CORS_ORIGIN:-*}"
vite_host="${PLASMA_VITE_HOST:-127.0.0.1}"
vite_port="${PLASMA_VITE_PORT:-5173}"
public_api_url="${PLASMA_PUBLIC_API_URL:-$default_public_api_url}"
manager_enabled="${PLASMA_MANAGER_ENABLED:-0}"
manager_config="${PLASMA_MANAGER_CONFIG:-$default_manager_config}"
engineering_mock_enabled="${PLASMA_ENGINEERING_MOCK_ENABLED:-0}"
engineering_mock_root="${PLASMA_ENGINEERING_MOCK_ROOT:-$state_home/plasma/engineering-mock}"
config_version="${PLASMA_CONFIG_VERSION:-1}"
unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
bin_dir="${PLASMACTL_BIN_DIR:-$HOME/.local/bin}"
core_services=(plasma-server.service plasma-web.service plasma-vite.service)
services=("${core_services[@]}")
if [[ "$manager_enabled" == "1" ]]; then
  services+=(plasma-manager.service)
fi
status_services=("${core_services[@]}" plasma-manager.service)

say() {
  printf '[plasmactl] %s\n' "$*"
}

die() {
  printf '[plasmactl] ERROR: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "找不到必要指令：$1"
}

require_repo() {
  [[ -d "$repo/.git" ]] || die "PLASMA_REPO 不是 Git repository：$repo"
  [[ -d "$python_dir" && -d "$web_dir" ]] || die "Plasma 專案目錄不完整：$repo"
}

require_runtime() {
  [[ -x "$python_bin" ]] || die "找不到 Python venv：$python_bin；請先執行 ./scripts/plasmactl install"
  [[ -n "$npm_bin" && -x "$npm_bin" ]] || die "找不到 npm；請先安裝 Node.js 22 與 npm"
}

require_clean_tree() {
  local changes
  changes="$(git -C "$repo" status --porcelain --untracked-files=normal)"
  [[ -z "$changes" ]] || {
    printf '%s\n' "$changes" >&2
    die "工作目錄有尚未提交的修改，取消更新以免覆蓋 SWPC 上的工作"
  }
}

require_user_units() {
  local service
  for service in "${core_services[@]}"; do
    [[ -f "$unit_dir/$service" ]] || die "尚未安裝 $service；請先執行 ./scripts/plasmactl install"
  done
}

validate_manager_settings() {
  [[ "$manager_enabled" == "0" || "$manager_enabled" == "1" ]] || \
    die "PLASMA_MANAGER_ENABLED 只接受 0 或 1：$manager_enabled"
  [[ "$manager_config" == /* ]] || \
    die "PLASMA_MANAGER_CONFIG 必須是絕對路徑：$manager_config"
}

validate_engineering_mock_settings() {
  [[ "$engineering_mock_enabled" == "0" || "$engineering_mock_enabled" == "1" ]] || \
    die "PLASMA_ENGINEERING_MOCK_ENABLED 只接受 0 或 1：$engineering_mock_enabled"
  [[ "$engineering_mock_root" == /* ]] || \
    die "PLASMA_ENGINEERING_MOCK_ROOT 必須是絕對路徑：$engineering_mock_root"
  case "$engineering_mock_root/" in
    "$repo/"*) die "PLASMA_ENGINEERING_MOCK_ROOT 不可位於 Git worktree 內：$engineering_mock_root" ;;
  esac
}

require_manager_config() {
  validate_manager_settings
  [[ "$manager_enabled" == "1" ]] || return 0
  [[ -f "$manager_config" ]] || \
    die "Plasma Manager 已啟用，但找不到設定檔：$manager_config"
  "$python_bin" -c \
    'from plasma_manager.config import load_manager_config; import sys; load_manager_config(sys.argv[1])' \
    "$manager_config" >/dev/null || die "Plasma Manager 設定檔驗證失敗：$manager_config"
}

manager_probe_url() {
  "$python_bin" -c '
from plasma_manager.config import load_manager_config
import sys
config = load_manager_config(sys.argv[1])
host = config.host
if host in {"0.0.0.0", "::"}:
    host = "127.0.0.1"
if ":" in host and not host.startswith("["):
    host = f"[{host}]"
print(f"http://{host}:{config.port}")
' "$manager_config"
}

manager_config_port() {
  "$python_bin" -c \
    'from plasma_manager.config import load_manager_config; import sys; print(load_manager_config(sys.argv[1]).port)' \
    "$manager_config"
}

replace_config_assignment() {
  local key="$1" value="$2" temporary
  temporary="$(mktemp "${config_file}.tmp.XXXXXX")"
  awk -v key="$key" -v value="$value" '
    BEGIN { replaced = 0 }
    $0 ~ ("^" key "=") {
      if (!replaced) {
        print key "=" value
        replaced = 1
      }
      next
    }
    { print }
    END {
      if (!replaced) {
        print key "=" value
      }
    }
  ' "$config_file" >"$temporary"
  mv "$temporary" "$config_file"
}

config_has_assignment() {
  local key="$1"
  grep -Eq "^${key}=" "$config_file"
}

ensure_config_completeness() {
  local repaired=0

  if ! config_has_assignment PLASMA_MANAGER_ENABLED; then
    replace_config_assignment PLASMA_MANAGER_ENABLED "$manager_enabled"
    PLASMA_MANAGER_ENABLED="$manager_enabled"
    repaired=1
  fi

  if ! config_has_assignment PLASMA_MANAGER_CONFIG; then
    replace_config_assignment PLASMA_MANAGER_CONFIG "$manager_config"
    PLASMA_MANAGER_CONFIG="$manager_config"
    repaired=1
  fi

  if ! config_has_assignment PLASMA_ENGINEERING_MOCK_ENABLED; then
    replace_config_assignment PLASMA_ENGINEERING_MOCK_ENABLED "$engineering_mock_enabled"
    PLASMA_ENGINEERING_MOCK_ENABLED="$engineering_mock_enabled"
    repaired=1
  fi

  if ! config_has_assignment PLASMA_ENGINEERING_MOCK_ROOT; then
    replace_config_assignment PLASMA_ENGINEERING_MOCK_ROOT "$engineering_mock_root"
    PLASMA_ENGINEERING_MOCK_ROOT="$engineering_mock_root"
    repaired=1
  fi

  if (( repaired )); then
    say "補齊 schema v$current_config_version 缺少的 deployment 欄位：$config_file"
  fi
}

migrate_config() {
  [[ -f "$config_file" ]] || return 0
  [[ "$config_version" =~ ^[0-9]+$ ]] || die "PLASMA_CONFIG_VERSION 必須是整數：$config_version"
  (( config_version <= current_config_version )) || \
    die "設定檔 schema v$config_version 高於此 plasmactl 支援的 v$current_config_version，拒絕修改"

  local previous_public_api_url="$public_api_url" migrated=0
  if (( config_version < 2 )); then
    case "$public_api_url" in
      https://swpc.tail820e64.ts.net|https://swpc.tail820e64.ts.net:8443|http://127.0.0.1:8080)
        public_api_url="$default_public_api_url"
        PLASMA_PUBLIC_API_URL="$public_api_url"
        ;;
      *)
        # Unknown values are treated as an explicit operator override and preserved.
        ;;
    esac
    replace_config_assignment PLASMA_PUBLIC_API_URL "$public_api_url"
  fi

  if (( config_version < 3 )); then
    replace_config_assignment PLASMA_MANAGER_ENABLED "$manager_enabled"
    replace_config_assignment PLASMA_MANAGER_CONFIG "$manager_config"
    PLASMA_MANAGER_ENABLED="$manager_enabled"
    PLASMA_MANAGER_CONFIG="$manager_config"
  fi

  if (( config_version < 4 )); then
    replace_config_assignment PLASMA_ENGINEERING_MOCK_ENABLED "$engineering_mock_enabled"
    replace_config_assignment PLASMA_ENGINEERING_MOCK_ROOT "$engineering_mock_root"
    PLASMA_ENGINEERING_MOCK_ENABLED="$engineering_mock_enabled"
    PLASMA_ENGINEERING_MOCK_ROOT="$engineering_mock_root"
  fi

  if (( config_version < current_config_version )); then
    replace_config_assignment PLASMA_CONFIG_VERSION "$current_config_version"
    config_version="$current_config_version"
    PLASMA_CONFIG_VERSION="$current_config_version"
    migrated=1
  fi

  ensure_config_completeness

  if (( migrated )); then
    if [[ "$previous_public_api_url" != "$public_api_url" ]]; then
      say "遷移舊 API Base：$previous_public_api_url → $public_api_url"
    else
      say "設定檔已升級至 schema v$current_config_version；保留 API Base：$public_api_url"
    fi
  fi
}

write_config() {
  mkdir -p "$(dirname "$config_file")"
  if [[ ! -f "$config_file" ]]; then
    cat >"$config_file" <<EOF
# Plasma integration-host deployment settings
PLASMA_CONFIG_VERSION=$current_config_version
PLASMA_REPO=$repo
PLASMA_BRANCH=$branch
PLASMA_NPM=$npm_bin
PLASMA_UV=$uv_bin
PLASMA_GATEWAY_HOST=$gateway_host
PLASMA_GATEWAY_PORT=$gateway_port
PLASMA_CORS_ORIGIN=$cors_origin
PLASMA_VITE_HOST=$vite_host
PLASMA_VITE_PORT=$vite_port
# URL shown as the Web Console's default Plasma Web REST Gateway. Do not append /api.
PLASMA_PUBLIC_API_URL=$public_api_url
# Plasma Manager is an optional control-plane service. Existing PPU deployments remain standalone by default.
PLASMA_MANAGER_ENABLED=$manager_enabled
# Operator-local Manager registry/configuration; keep fleet endpoints outside the Git worktree.
PLASMA_MANAGER_CONFIG=$manager_config
# Engineering Mock PPU Provider is opt-in. Keep simulation state outside the Git worktree.
PLASMA_ENGINEERING_MOCK_ENABLED=$engineering_mock_enabled
PLASMA_ENGINEERING_MOCK_ROOT=$engineering_mock_root
EOF
    config_version="$current_config_version"
    say "建立設定檔：$config_file"
  else
    migrate_config
    say "保留既有設定檔：$config_file"
  fi
}

validate_unit_values() {
  local value
  validate_manager_settings
  validate_engineering_mock_settings
  for value in "$repo" "$python_bin" "$npm_bin" "$gateway_host" "$gateway_port" \
    "$cors_origin" "$vite_host" "$vite_port" "$public_api_url" "$manager_config" "$engineering_mock_root"; do
    [[ "$value" != *$'\n'* ]] || die "systemd 設定值不可包含換行"
  done
  [[ "$repo" != *' '* && "$python_bin" != *' '* && "$npm_bin" != *' '* && "$manager_config" != *' '* && \
    "$engineering_mock_root" != *' '* ]] || \
    die "目前安裝腳本不支援含空白的 repository、Python、npm、Manager config 或 Engineering Mock root 路徑"
}

write_units() {
  local node_path public_api_environment engineering_mock_args
  node_path="$(dirname "$npm_bin"):/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  public_api_environment=""
  engineering_mock_args=""
  if [[ -n "$public_api_url" ]]; then
    public_api_environment="Environment=NEXT_PUBLIC_PLASMA_API_URL=$public_api_url"
  fi
  if [[ "$engineering_mock_enabled" == "1" ]]; then
    engineering_mock_args=" --engineering-mock --engineering-mock-root $engineering_mock_root"
  fi

  mkdir -p "$unit_dir"
  cat >"$unit_dir/plasma-server.service" <<EOF
[Unit]
Description=Plasma PPU Programming Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=$python_dir
Environment=PYTHONUNBUFFERED=1
ExecStart=$python_bin -m plasma_server.server --config config/plasma.yaml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
EOF

  cat >"$unit_dir/plasma-web.service" <<EOF
[Unit]
Description=Plasma Web REST Gateway
After=network-online.target plasma-server.service
Wants=network-online.target plasma-server.service

[Service]
Type=simple
WorkingDirectory=$python_dir
Environment=PYTHONUNBUFFERED=1
ExecStart=$python_bin -m plasma_web.gateway --host $gateway_host --port $gateway_port --plasma-host 127.0.0.1 --plasma-port 9900 --output-root $python_dir/output --cors-origin $cors_origin$engineering_mock_args
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
EOF

  cat >"$unit_dir/plasma-vite.service" <<EOF
[Unit]
Description=Plasma Vite Web Console
After=network-online.target plasma-web.service
Wants=network-online.target plasma-web.service

[Service]
Type=simple
WorkingDirectory=$web_dir
Environment=PATH=$node_path
$public_api_environment
ExecStart=$npm_bin run dev -- --host $vite_host --port $vite_port
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
EOF

  cat >"$unit_dir/plasma-manager.service" <<EOF
[Unit]
Description=Plasma Manager Read-only Fleet Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=$python_dir
Environment=PYTHONUNBUFFERED=1
ExecStart=$python_bin -m plasma_manager.server --config $manager_config
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
EOF
}

install_dependencies() {
  require_command python3
  if [[ ! -x "$python_bin" ]]; then
    say "建立 Python virtual environment"
    python3 -m venv "$python_dir/.venv"
  fi
  say "同步 Python 開發相依套件"
  install_python_dependencies

  [[ -n "$npm_bin" && -x "$npm_bin" ]] || die "找不到 npm；請先安裝 Node.js 22 與 npm"
  say "同步 Web 相依套件"
  (cd "$web_dir" && "$npm_bin" ci)
}

install_python_dependencies() {
  if "$python_bin" -m pip --version >/dev/null 2>&1; then
    "$python_bin" -m pip install -e "$python_dir[dev]"
  elif [[ -n "$uv_bin" && -x "$uv_bin" ]]; then
    say "Python venv 沒有 pip，改用 uv：$uv_bin"
    "$uv_bin" pip install --python "$python_bin" -e "$python_dir[dev]"
  else
    die "Python venv 沒有 pip，且找不到 uv；請確認 $HOME/.local/bin/uv"
  fi
}

reconcile_service_enablement() {
  systemctl --user enable "${core_services[@]}" >/dev/null
  if [[ "$manager_enabled" == "1" ]]; then
    systemctl --user enable plasma-manager.service >/dev/null
  else
    systemctl --user disable plasma-manager.service >/dev/null 2>&1 || true
  fi
}

install_services() {
  local login_user
  require_repo
  require_command systemctl
  install_dependencies
  write_config
  validate_unit_values
  require_manager_config
  write_units
  mkdir -p "$bin_dir"
  ln -sfn "$script_path" "$bin_dir/plasmactl"
  systemctl --user daemon-reload
  reconcile_service_enablement
  login_user="${USER:-$(id -un)}"
  say "已安裝 user systemd units，但尚未啟動，避免與目前手動程序爭用 Port"
  if [[ "$manager_enabled" == "1" ]]; then
    say "Plasma Manager 已設定為 opt-in enabled：$manager_config"
  else
    say "Plasma Manager 保持 disabled；PPU standalone execution 不依賴 Manager"
  fi
  if [[ "$engineering_mock_enabled" == "1" ]]; then
    say "Engineering Mock PPU Provider 已設定為 opt-in enabled：$engineering_mock_root"
  else
    say "Engineering Mock PPU Provider 保持 disabled"
  fi
  say "管理指令：$bin_dir/plasmactl"
  say "先執行 plasmactl ports，確認舊程序後，再執行 plasmactl start"
  say "若要開機後不登入也自動啟動，另執行：sudo loginctl enable-linger $login_user"
}

web_runtime_changed() {
  local changed="$1"
  grep -Eq '^software/web/' <<<"$changed"
}

web_dependencies_changed() {
  local changed="$1"
  grep -Eq '^software/web/package-lock\.json$' <<<"$changed"
}

web_manifest_matches_lock() {
  "$python_bin" - "$web_dir/package.json" "$web_dir/package-lock.json" <<'PY'
import json
import sys

package_path, lock_path = sys.argv[1:]
with open(package_path, encoding="utf-8") as handle:
    package = json.load(handle)
with open(lock_path, encoding="utf-8") as handle:
    lock = json.load(handle)

root = lock.get("packages", {}).get("", {})
keys = ("dependencies", "devDependencies", "optionalDependencies", "peerDependencies")
for key in keys:
    if package.get(key, {}) != root.get(key, {}):
        raise SystemExit(1)
PY
}

sync_changed_dependencies() {
  local before="$1" after="$2" changed
  [[ "$before" != "$after" ]] || return 0
  changed="$(git -C "$repo" diff --name-only "$before" "$after")"
  if grep -Eq '^software/python/(pyproject.toml|.*requirements.*)$' <<<"$changed"; then
    say "Python 相依設定有更新，重新安裝"
    install_python_dependencies
  fi
  if web_dependencies_changed "$changed"; then
    say "Web lockfile 有更新，執行 npm ci"
    (cd "$web_dir" && "$npm_bin" ci)
  elif grep -Eq '^software/web/package\.json$' <<<"$changed"; then
    if ! web_manifest_matches_lock; then
      die "software/web/package.json 的 dependency manifest 與 package-lock.json 不一致"
    fi
    say "Web package metadata 有更新但 lockfile 未變；略過 npm ci，避免擾動執行中的 Vite runtime"
  fi
}

update_code() {
  local before local_ahead remote_ahead after changed
  require_repo
  require_runtime
  require_clean_tree
  [[ "$(git -C "$repo" branch --show-current)" == "$branch" ]] || die "目前分支不是 $branch"

  before="$(git -C "$repo" rev-parse HEAD)"
  say "從 origin/$branch 取得最新程式"
  git -C "$repo" fetch --prune origin "$branch"
  read -r local_ahead remote_ahead < <(
    git -C "$repo" rev-list --left-right --count "HEAD...origin/$branch"
  )
  [[ "$local_ahead" == "0" ]] || die "SWPC 有 $local_ahead 個尚未推送的本機 commit，拒絕自動部署"
  git -C "$repo" merge --ff-only "origin/$branch"
  after="$(git -C "$repo" rev-parse HEAD)"
  changed="$(git -C "$repo" diff --name-only "$before" "$after")"
  sync_changed_dependencies "$before" "$after"
  say "目前版本：$(git -C "$repo" log -1 --oneline)"
  if web_runtime_changed "$changed"; then
    say "Web source 已更新；長駐 Vite/HMR 不視為已完成部署"
    say "瀏覽器驗證前請執行 plasmactl web-restart；plasmactl deploy 會在測試通過後自動重新啟動全部服務"
  fi
}

run_tests() {
  require_repo
  require_runtime
  say "執行 deployment config migration、Manager service、Engineering Mock Provider 與 Web lifecycle 測試"
  bash "$repo/scripts/tests/test-plasmactl-config.sh" || return 1
  bash "$repo/scripts/tests/test-plasmactl-engineering-mock.sh" || return 1
  say "執行 Python 與 PL source-layout pytest"
  (cd "$python_dir" && "$python_bin" -m pytest -q tests "$repo/pl/tests") || return 1
  say "執行 Web lint、test 與 artifact validation"
  (cd "$web_dir" && "$npm_bin" run lint) || return 1
  (cd "$web_dir" && "$npm_bin" test) || return 1
  (cd "$web_dir" && "$npm_bin" run validate:artifact) || return 1
  say "所有測試通過"
}

wait_for_port() {
  local host="$1" port="$2" label="$3" attempt
  for attempt in {1..30}; do
    if (exec 3<>"/dev/tcp/$host/$port") 2>/dev/null; then
      exec 3>&-
      exec 3<&-
      say "$label 已監聽 $host:$port"
      return 0
    fi
    sleep 0.5
  done
  die "$label 未在期限內監聽 $host:$port"
}

wait_for_http() {
  local url="$1" label="$2" attempt
  for attempt in {1..30}; do
    if curl --fail --silent --max-time 2 "$url" >/dev/null 2>&1; then
      say "$label 正常"
      return 0
    fi
    sleep 0.5
  done
  die "$label 未在期限內通過健康檢查：$url"
}

web_health_check() {
  require_command curl
  wait_for_http "http://127.0.0.1:$vite_port/" "Vite Web Console"
}

engineering_mock_health_check() {
  [[ "$engineering_mock_enabled" == "1" ]] || return 0
  require_command curl
  wait_for_http "http://127.0.0.1:$gateway_port/api/engineering/targets" "Engineering Mock PPU Provider"
}

manager_health_check() {
  [[ "$manager_enabled" == "1" ]] || return 0
  require_manager_config
  require_command systemctl
  systemctl --user is-active --quiet plasma-manager.service || \
    die "Plasma Manager systemd service 未處於 active 狀態"
  local manager_url
  manager_url="$(manager_probe_url)"
  wait_for_http "$manager_url/api/health/live" "Plasma Manager"
  systemctl --user is-active --quiet plasma-manager.service || \
    die "Plasma Manager liveness 回應存在，但 systemd service 已離開 active 狀態"
}

health_check() {
  require_command curl
  wait_for_port 127.0.0.1 9900 "Plasma Server"
  wait_for_http "http://127.0.0.1:$gateway_port/api/status" "Plasma Web REST Gateway"
  engineering_mock_health_check
  web_health_check
  manager_health_check
}

reconcile_service_units() {
  require_user_units
  require_command systemctl
  write_config
  validate_unit_values
  require_manager_config
  write_units
  systemctl --user daemon-reload
  reconcile_service_enablement
}

stop_disabled_manager() {
  if [[ "$manager_enabled" != "1" ]]; then
    systemctl --user stop plasma-manager.service >/dev/null 2>&1 || true
  fi
}

start_services() {
  reconcile_service_units
  stop_disabled_manager
  systemctl --user start "${services[@]}"
  health_check
}

restart_services() {
  reconcile_service_units
  stop_disabled_manager
  say "重新啟動 Plasma 服務"
  systemctl --user restart "${services[@]}"
  health_check
}

restart_web_console() {
  require_repo
  require_runtime
  reconcile_service_units
  say "重新啟動 Vite Web Console，丟棄舊的 in-memory module graph / HMR state"
  systemctl --user restart plasma-vite.service
  web_health_check
  say "Web runtime 已重新載入；若瀏覽器仍持有舊 ESM module，請執行 hard reload"
}

stop_services() {
  require_user_units
  systemctl --user stop plasma-manager.service >/dev/null 2>&1 || true
  systemctl --user stop plasma-vite.service plasma-web.service plasma-server.service
  say "Plasma 服務已停止"
}

show_ports() {
  local manager_port_value=""
  if [[ "$manager_enabled" == "1" && -f "$manager_config" ]]; then
    manager_port_value="$(manager_config_port 2>/dev/null || true)"
  fi
  if [[ -n "$manager_port_value" ]]; then
    printf '\nListening ports (9900 / %s / %s / Manager %s):\n' "$gateway_port" "$vite_port" "$manager_port_value"
  else
    printf '\nListening ports (9900 / %s / %s):\n' "$gateway_port" "$vite_port"
  fi
  ss -lntp 2>/dev/null | awk \
    -v gateway=":$gateway_port" -v vite=":$vite_port" -v manager=":$manager_port_value" \
    '$4 ~ /:9900$/ || index($4, gateway) || index($4, vite) || (manager != ":" && index($4, manager))'
}

show_status() {
  require_repo
  printf 'Version:  %s\n' "$(git -C "$repo" log -1 --oneline)"
  printf 'Branch:   %s\n' "$(git -C "$repo" branch --show-current)"
  printf 'Worktree: %s\n' "$(if [[ -z "$(git -C "$repo" status --porcelain)" ]]; then echo clean; else echo modified; fi)"
  printf 'Manager:  %s\n' "$(if [[ "$manager_enabled" == "1" ]]; then echo enabled; else echo disabled; fi)"
  printf 'Eng Mock: %s\n' "$(if [[ "$engineering_mock_enabled" == "1" ]]; then echo "enabled ($engineering_mock_root)"; else echo disabled; fi)"
  printf '\n%-24s %s\n' SERVICE STATE
  local service state load_state
  for service in "${status_services[@]}"; do
    load_state="$(systemctl --user show "$service" --property=LoadState --value 2>/dev/null || true)"
    state="$(systemctl --user show "$service" --property=ActiveState --value 2>/dev/null || true)"
    if [[ "$load_state" == "not-found" || -z "$load_state" ]]; then
      state="not-installed"
    elif [[ "$state" =~ ^(active|inactive|failed|activating|deactivating|reloading)$ ]]; then
      :
    else
      state="systemd-unavailable"
    fi
    if [[ "$service" == "plasma-manager.service" && "$manager_enabled" != "1" ]]; then
      if [[ "$state" == "active" ]]; then
        state="active (config-disabled)"
      else
        state="disabled"
      fi
    fi
    printf '%-24s %s\n' "$service" "$state"
  done
  show_ports
}

show_logs() {
  local target="${1:-all}" units=()
  case "$target" in
    all) units=(-u plasma-server.service -u plasma-web.service -u plasma-vite.service -u plasma-manager.service) ;;
    server) units=(-u plasma-server.service) ;;
    web|gateway) units=(-u plasma-web.service) ;;
    vite|console) units=(-u plasma-vite.service) ;;
    manager) units=(-u plasma-manager.service) ;;
    *) die "logs 只接受 all、server、web/gateway、vite/console 或 manager" ;;
  esac
  journalctl --user "${units[@]}" -n 100 -f
}

render_deploy() {
  bash "$repo/scripts/render-deploy.sh"
}

deploy() {
  if [[ "${PLASMACTL_DEPLOY_REEXEC:-0}" != "1" ]]; then
    update_code
    say "重新載入更新後的部署邏輯"
    PLASMACTL_DEPLOY_REEXEC=1 exec "$script_path" deploy
  fi

  if ! run_tests; then
    die "測試失敗；程式已更新，但既有服務未重新啟動"
  fi
  restart_services
  say "部署完成：$(git -C "$repo" log -1 --oneline)"
}

usage() {
  cat <<'EOF'
Usage: plasmactl COMMAND

Commands:
  install              安裝相依套件與 user systemd units（不立即啟動）
  update               從 GitHub main 做 fast-forward 更新；Web 變更後需 restart 才算 runtime 完成
  test                 執行 deployment migration/Manager/Engineering Mock lifecycle、Python、PL source-layout 與 Web 測試
  restart              重新產生 systemd units、重新啟動已啟用服務並執行 health check
  web-restart          只重新啟動 Vite Web Console 並執行 Web HTTP health check
  deploy               update → re-exec latest plasmactl → test → reconcile units → restart
  update-and-restart   deploy 的別名
  render-deploy        透過 secret Render Deploy Hook 觸發 linked branch 最新 commit 部署
  verify fleet         唯讀驗證 Manager/Fleet 部署後 runtime chain；不取代人工 UI 驗收
  start | stop         啟動或停止 Plasma 服務；Manager 只有 opt-in enabled 時會啟動
  status               顯示 Git、systemd、Manager/Engineering Mock opt-in 與 Port 狀態
  ports                顯示 9900、Gateway、Vite，以及啟用時的 Manager Port
  logs [TARGET]        即時顯示 Log；TARGET: all/server/web/vite/manager
  help                 顯示本說明
EOF
}

if [[ "${PLASMACTL_LIB_ONLY:-0}" == "1" ]]; then
  return 0 2>/dev/null || exit 0
fi

command="${1:-help}"
shift || true
case "$command" in
  install) install_services ;;
  update) update_code ;;
  test) run_tests ;;
  restart) restart_services ;;
  web-restart|restart-web) restart_web_console ;;
  deploy|update-and-restart) deploy ;;
  render-deploy|deploy-render) render_deploy ;;
  verify) bash "$repo/scripts/plasmactl-verify" "${1:-}" ;;
  start) start_services ;;
  stop) stop_services ;;
  status) show_status ;;
  ports) show_ports ;;
  logs) show_logs "${1:-all}" ;;
  help|-h|--help) usage ;;
  *) usage >&2; die "未知指令：$command" ;;
esac
