#!/usr/bin/env bash
# Repository launcher for the one PLASMA operator CLI.
# Canonical implementation: utilities/plasmactl/ (Python, path-neutral).
# This file only (a) points the CLI at this checkout's platform backends and
# (b) keeps the integration library mode used by the integration backend tests.
set -Eeuo pipefail

wrapper_path="$(readlink -f "${BASH_SOURCE[0]}")"
repo_root="$(cd "$(dirname "$wrapper_path")/.." && pwd)"
# Documentation/contract marker; the integration backend owns config migration.
current_config_version=6

if [[ "${PLASMACTL_LIB_ONLY:-0}" == "1" ]]; then
  integration_backend="${PLASMACTL_INTEGRATION_BACKEND:-$repo_root/scripts/plasmactl-integration}"
  # shellcheck source=/dev/null
  source "$integration_backend"
  # Re-exec `deploy` and the installed ~/.local/bin/plasmactl through this launcher.
  script_path="$wrapper_path"
  return 0 2>/dev/null || exit 0
fi

utility_root="$repo_root/utilities/plasmactl/src"
[[ -f "$utility_root/plasma_cli/main.py" ]] || {
  printf '[plasmactl] ERROR: unified CLI source is missing: %s\n' "$utility_root" >&2
  exit 1
}
export PLASMA_CLI_BACKEND_DIR="$repo_root/scripts"
# Never write bytecode into a verified, hash-pinned kit or release tree.
export PYTHONDONTWRITEBYTECODE=1
export PLASMACTL_WRAPPER="$wrapper_path"
PYTHONPATH="$utility_root${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m plasma_cli.main "$@"
