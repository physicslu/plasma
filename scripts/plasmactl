#!/usr/bin/env bash
set -Eeuo pipefail

wrapper_path="$(readlink -f "${BASH_SOURCE[0]}")"
repo_root="$(cd "$(dirname "$wrapper_path")/.." && pwd)"
integration_backend="${PLASMACTL_INTEGRATION_BACKEND:-$repo_root/scripts/plasmactl-integration}"
local_control_station_backend="${PLASMA_LOCAL_CONTROL_STATION_BACKEND:-$repo_root/scripts/plasmactl-local-control-station}"
swpc_z2like_backend="${PLASMA_SWPC_Z2LIKE_BACKEND:-$repo_root/scripts/plasmactl-swpc-z2like}"
z2_ps_backend="${PLASMA_Z2_PS_BACKEND:-$repo_root/scripts/plasmactl-z2-ps}"
# Compatibility marker for repository documentation/contracts. The integration
# backend owns migration behavior; the operator entrypoint publishes its schema.
current_config_version=6

wrapper_die() {
  printf '[plasmactl] ERROR: %s\n' "$*" >&2
  exit 1
}

require_backend() {
  local path="$1" label="$2"
  [[ -f "$path" ]] || wrapper_die "$label backend is missing: $path"
}

load_integration_backend() {
  require_backend "$integration_backend" "integration"
  local previous_lib_only="${PLASMACTL_LIB_ONLY-__unset__}"
  PLASMACTL_LIB_ONLY=1
  # shellcheck source=/dev/null
  source "$integration_backend"
  if [[ "$previous_lib_only" == "__unset__" ]]; then
    unset PLASMACTL_LIB_ONLY
  else
    PLASMACTL_LIB_ONLY="$previous_lib_only"
  fi
  # The legacy implementation deliberately keeps all integration-host behavior.
  # Reset only its re-exec/install entrypoint so `plasmactl deploy` and the
  # installed ~/.local/bin/plasmactl symlink continue through this profile router.
  script_path="$wrapper_path"
}

run_local_control_station_backend() {
  require_backend "$local_control_station_backend" "local-control-station"
  bash "$local_control_station_backend" "$@"
}

run_swpc_z2like_backend() {
  require_backend "$swpc_z2like_backend" "swpc-z2like"
  bash "$swpc_z2like_backend" "$@"
}

run_z2_ps_backend() {
  require_backend "$z2_ps_backend" "z2-ps"
  bash "$z2_ps_backend" "$@"
}

profile_for_optional_arg() {
  case "${1:-}" in
    ""|integration) printf '%s\n' integration ;;
    local-control-station) printf '%s\n' local-control-station ;;
    swpc-z2like) printf '%s\n' swpc-z2like ;;
    z2-ps) printf '%s\n' z2-ps ;;
    *) return 1 ;;
  esac
}

usage() {
  cat <<'EOF'
Usage: plasmactl COMMAND [PROFILE] [OPTIONS]

Deployment profiles:
  integration             SWPC development/integration host; user systemd, Vite, optional Manager/Mock
  local-control-station   Linux reference Control Station; Console/BFF + Manager only, user systemd
  swpc-z2like             x86_64 PS-only PPU surrogate; root/system systemd, immutable release, restricted ingress
  z2-ps                   Real PYNQ-Z2 ARMv7 PS-only PPU runtime; no PL/Site/IC claim

Profile-aware commands:
  install [integration]              Legacy integration-host install (default; backward compatible)
  deploy [integration]               Legacy update -> test -> restart deployment (default)
  status [integration]               Legacy integration-host runtime status
  verify fleet                       Legacy Manager/Fleet read-only verification

  plasmactl install local-control-station --ppu-endpoint URL [--ppu-alias ALIAS] [--python PATH]
  plasmactl deploy local-control-station  [--ppu-endpoint URL] [--ppu-alias ALIAS] [--python PATH]
  plasmactl verify local-control-station  Local Console + Manager qualification; PPU reachability is separate
  plasmactl status local-control-station  Installed release, configured target and user-service state

  sudo plasmactl install swpc-z2like [--plasma-python PATH] [--ppu-id ID] [--facility-id ID] [--proxy-port PORT]
  sudo plasmactl deploy swpc-z2like  [same options]
  plasmactl verify swpc-z2like       Read-only local surrogate readiness/restricted-ingress/PS-loopback checks
  plasmactl status swpc-z2like       Installed release identity and system-service state

  sudo plasmactl install z2-ps --release-artifact PATH --gateway-host IPv4 \
    [--python-artifact PATH | --plasma-python PATH] [--ppu-id ID] [--facility-id ID]
  sudo plasmactl deploy z2-ps --release-artifact PATH --gateway-host IPv4 [same identity/runtime options]
  plasmactl verify z2-ps             Real Z2 ARMv7 PS runtime + local PS diagnostic loopback only
  plasmactl status z2-ps             Installed release, Plasma Python and system-service state

Integration-only commands retained unchanged:
  update | test | restart | web-restart | start | stop | ports | logs [TARGET]
  update-and-restart                  Alias of `deploy integration`

Future hardware profiles:
  z2-full remains reserved for PS + PL + Site/Programming qualification. `z2` is
  intentionally not accepted until z2-full is qualified; neither aliases swpc-z2like.

Safety boundary:
  `local-control-station` proves only the local Console/BFF + Manager runtime.
  `swpc-z2like` is not Z2/ARMv7 qualification.
  `z2-ps` proves only real-Z2 ARMv7 PS software/runtime and local PS diagnostics;
  none of these profiles alone proves PL, FPGA, Site electrical, real-IC programming,
  eight-site hardware concurrency, or production programmer readiness.
EOF
}

if [[ "${PLASMACTL_LIB_ONLY:-0}" == "1" ]]; then
  load_integration_backend
  return 0 2>/dev/null || exit 0
fi

command="${1:-help}"
shift || true

case "$command" in
  install)
    profile="$(profile_for_optional_arg "${1:-}")" || wrapper_die "unknown deployment profile: ${1:-}"
    [[ "${1:-}" == "$profile" ]] && shift || true
    case "$profile" in
      local-control-station) run_local_control_station_backend install "$@" ;;
      swpc-z2like) run_swpc_z2like_backend install "$@" ;;
      z2-ps) run_z2_ps_backend install "$@" ;;
      integration)
        (($# == 0)) || wrapper_die "integration install does not accept profile options"
        load_integration_backend
        install_services
        ;;
    esac
    ;;
  deploy)
    profile="$(profile_for_optional_arg "${1:-}")" || wrapper_die "unknown deployment profile: ${1:-}"
    [[ "${1:-}" == "$profile" ]] && shift || true
    case "$profile" in
      local-control-station) run_local_control_station_backend deploy "$@" ;;
      swpc-z2like) run_swpc_z2like_backend deploy "$@" ;;
      z2-ps) run_z2_ps_backend deploy "$@" ;;
      integration)
        (($# == 0)) || wrapper_die "integration deploy does not accept profile options"
        load_integration_backend
        deploy
        ;;
    esac
    ;;
  update-and-restart)
    case "${1:-}" in
      ""|integration)
        [[ "${1:-}" == "integration" ]] && shift || true
        (($# == 0)) || wrapper_die "update-and-restart is an integration-only alias"
        load_integration_backend
        deploy
        ;;
      *)
        wrapper_die "update-and-restart is an integration-only alias; use 'plasmactl deploy PROFILE'"
        ;;
    esac
    ;;
  status)
    profile="$(profile_for_optional_arg "${1:-}")" || wrapper_die "unknown deployment profile: ${1:-}"
    [[ "${1:-}" == "$profile" ]] && shift || true
    (($# == 0)) || wrapper_die "status accepts one deployment profile only"
    case "$profile" in
      local-control-station) run_local_control_station_backend status ;;
      swpc-z2like) run_swpc_z2like_backend status ;;
      z2-ps) run_z2_ps_backend status ;;
      integration)
        load_integration_backend
        show_status
        ;;
    esac
    ;;
  verify)
    case "${1:-}" in
      local-control-station)
        shift
        run_local_control_station_backend verify "$@"
        ;;
      swpc-z2like)
        shift
        run_swpc_z2like_backend verify "$@"
        ;;
      z2-ps)
        shift
        run_z2_ps_backend verify "$@"
        ;;
      integration)
        shift
        load_integration_backend
        bash "$repo/scripts/plasmactl-verify" "${1:-}"
        ;;
      *)
        load_integration_backend
        bash "$repo/scripts/plasmactl-verify" "${1:-}"
        ;;
    esac
    ;;
  update)
    (($# == 0)) || wrapper_die "update is integration-only and accepts no profile argument"
    load_integration_backend
    update_code
    ;;
  test)
    (($# == 0)) || wrapper_die "test is integration-only and accepts no profile argument"
    load_integration_backend
    run_tests
    ;;
  restart)
    (($# == 0)) || wrapper_die "restart is integration-only and accepts no profile argument"
    load_integration_backend
    restart_services
    ;;
  web-restart|restart-web)
    (($# == 0)) || wrapper_die "web-restart is integration-only and accepts no profile argument"
    load_integration_backend
    restart_web_console
    ;;
  start)
    (($# == 0)) || wrapper_die "start is integration-only and accepts no profile argument"
    load_integration_backend
    start_services
    ;;
  stop)
    (($# == 0)) || wrapper_die "stop is integration-only and accepts no profile argument"
    load_integration_backend
    stop_services
    ;;
  ports)
    (($# == 0)) || wrapper_die "ports is integration-only and accepts no profile argument"
    load_integration_backend
    show_ports
    ;;
  logs)
    target="${1:-all}"
    shift || true
    (($# == 0)) || wrapper_die "logs accepts at most one integration log target"
    load_integration_backend
    show_logs "$target"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    wrapper_die "unknown command: $command"
    ;;
esac
