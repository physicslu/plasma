#!/usr/bin/env bash
# Z2 root-owned fixed entry. Installation never launches a hardware stage.
# Not an SSH client, privilege escalator, runner, or command interpreter.
set -euo pipefail
[[ $# -eq 1 ]] || { echo 'PATH2_STAGE_ARGUMENT_REQUIRED' >&2; exit 2; }
case "$1" in
  download|test|restore) stage="$1" ;;
  *) echo 'PATH2_STAGE_NOT_ALLOWLISTED' >&2; exit 2 ;;
esac

[[ "$(id -u)" == '0' ]] || { echo 'PATH2_ROOT_REQUIRED' >&2; exit 2; }
root=/root/plasma-path2-f1b-site1-approved
python=/opt/plasma/python/3.12.13/bin/python3
manifest="$root/.plasma-path2-source-sha256"

[[ -d "$root" && ! -L "$root" && -f "$manifest" && ! -L "$manifest" ]] ||
  { echo 'PATH2_APPROVED_ROOT_SOURCE_NOT_INSTALLED' >&2; exit 2; }
[[ -f "$python" && -x "$python" ]] ||
  { echo 'PATH2_PINNED_PYTHON_NOT_INSTALLED' >&2; exit 2; }

# The root operator must install an exact, reviewed tree and its private
# SHA256 manifest. A PR checkout or a GitHub CI job cannot self-enroll.
for path in "$root" "$manifest" "$root/pl/hil/path2_f1b_minimal_stage.py"; do
  [[ ! -L "$path" && "$(stat -c '%u' "$path")" == '0' ]] ||
    { echo 'PATH2_SOURCE_NOT_ROOT_OWNED' >&2; exit 2; }
  perm="$(stat -c '%a' "$path")"
  (( (8#$perm & 0022) == 0 )) ||
    { echo 'PATH2_SOURCE_WRITABLE_BY_OTHERS' >&2; exit 2; }
done

(cd "$root" && /usr/bin/sha256sum --check --status .plasma-path2-source-sha256) ||
  { echo 'PATH2_APPROVED_SOURCE_HASH_MISMATCH' >&2; exit 2; }

# No shell eval, caller-controlled paths, dynamic Python package or extra args.
cd "$root"
exec /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root \
  PYTHONPATH="$root" \
  PLASMA_DEV_RISK_ACK=PLASMA_PATH2_F1B_SITE1_20261021_ONCE_BOUND_PASSIVE_UIO \
  "$python" -m pl.hil.path2_f1b_minimal_stage "$stage"
