{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plasma.programming.loading-benchmark.v1",
  "title": "PLASMA Programming Loading Benchmark v1",
  "type": "object",
  "required": ["schema", "outcome", "source_sha", "blocker", "batch_post_count", "start_post_count", "hardware", "reset_run"],
  "properties": {
    "schema": {"const": "plasma.programming.loading-benchmark.v1"},
    "outcome": {"enum": ["PASS", "FAIL", "NOT_RUN", "OUTCOME_UNKNOWN", "INSUFFICIENT_SAMPLES", "NOT_OBSERVED"]},
    "source_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "blocker": {"type": ["string", "null"], "maxLength": 128},
    "batch_post_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "start_post_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "hardware": {"enum": ["NOT_RUN", "SUBMITTED"]},
    "reset_run": {"const": "EXISTING_POST_PROGRAM_RESET_RUN_ACCEPTED"},
    "start_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "batch_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "comparison": {
      "type": "object",
      "required": ["phases", "pids", "sampled_pid_overlap_s", "overlap_status", "overlap_boundary_uncertainty_s", "missed_samples"],
      "properties": {
        "phases": {
          "type": "object",
          "required": ["idle", "single_site", "dual_site", "batch_no_pid", "recovery"],
          "additionalProperties": {"$ref": "#/$defs/phase"}
        },
        "pids": {"type": "object"},
        "sampled_pid_overlap_s": {"type": "number", "minimum": 0},
        "overlap_status": {"enum": ["OBSERVED", "NOT_OBSERVED"]},
        "overlap_boundary_uncertainty_s": {"type": "number", "minimum": 0},
        "missed_samples": {"type": "integer", "minimum": 0}
      }
    },
    "jobs": {"type": "array", "maxItems": 2, "items": {"type": "object"}}
  },
  "allOf": [{"if": {"properties": {"outcome": {"const": "PASS"}}},
    "then": {"required": ["jobs", "comparison", "batch_id", "start_id", "deployed_identity", "final_idle", "throughput"],
      "properties": {"final_idle": {"const": true}, "batch_post_count": {"const": 1},
                     "jobs": {"minItems": 2}}}}],
  "$defs": {
    "stats": {
      "type": "object", "required": ["n", "mean", "p95", "peak"],
      "properties": {"n": {"type": "integer", "minimum": 0}, "mean": {"type": ["number", "null"]},
                     "p95": {"type": ["number", "null"]}, "peak": {"type": ["number", "null"]}}
    },
    "phase": {
      "type": "object", "required": ["n", "duration_s", "cpu_pct", "ram_used_kib", "quality", "cpu_delta_pp", "ram_delta_pp"],
      "properties": {"n": {"type": "integer", "minimum": 0}, "duration_s": {"type": "number", "minimum": 0},
        "cpu_pct": {"$ref": "#/$defs/stats"}, "ram_used_kib": {"$ref": "#/$defs/stats"},
        "quality": {"enum": ["OBSERVED", "NOT_OBSERVED", "INSUFFICIENT_SAMPLES"]}}
    }
  }
}
