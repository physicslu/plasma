# PYNQ-Z2 PMODB. PINS MUST BE VERIFIED AGAINST PHYSICAL BOARD BEFORE
# CONNECTING AN IC. 3.3V LVCMOS, NOT 5V tolerant, not a power source.
# On this proof-of-path design:
#   JB[0] W14 -> SWCLK (EMIO GPIO 0)
#   JB[1] Y14 -> SWDIO (EMIO GPIO 1, bidirectional IOBUF)
#   JB[2] T11 -> nRESET (EMIO GPIO 2, low or Hi-Z only)
set_property -dict {PACKAGE_PIN W14 IOSTANDARD LVCMOS33} [get_ports swclk_io]
set_property -dict {PACKAGE_PIN Y14 IOSTANDARD LVCMOS33} [get_ports swdio_io]
set_property -dict {PACKAGE_PIN T11 IOSTANDARD LVCMOS33} [get_ports nrst_io]
# Do NOT add PULLUP/DRIVE/HIGH_SPEED without board-level electrical review.
# FCLK0 is generated by PS7 at 100 MHz; IP Integrator supplies its constraint.
