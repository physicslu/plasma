set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ARM_GCC_ROOT)
if(NOT DEFINED ARM_GCC_ROOT)
  message(FATAL_ERROR "Set ARM_GCC_ROOT to the extracted Arm GNU toolchain prefix")
endif()
set(CMAKE_C_COMPILER "${ARM_GCC_ROOT}/usr/bin/arm-none-eabi-gcc")
set(CMAKE_ASM_COMPILER "${ARM_GCC_ROOT}/usr/bin/arm-none-eabi-gcc")
set(CMAKE_OBJCOPY "${ARM_GCC_ROOT}/usr/bin/arm-none-eabi-objcopy")
set(CMAKE_SIZE "${ARM_GCC_ROOT}/usr/bin/arm-none-eabi-size")
set(CMAKE_FIND_ROOT_PATH "${ARM_GCC_ROOT}/usr")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_C_FLAGS_INIT "-isystem ${ARM_GCC_ROOT}/usr/include/newlib")
