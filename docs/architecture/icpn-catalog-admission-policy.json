{
  "schema_version": 1,
  "policy_id": "icpn-catalog-admission-separation",
  "authority": "architecture_contract",
  "catalog_admission": {
    "requires_exact_manufacturer_part_number_evidence": true,
    "requires_deterministic_metadata_normalization": true,
    "requires_deterministic_backend_route_or_explicit_mapping_state": true,
    "requires_provenance_and_integrity_evidence": true,
    "requires_catalog_ci": true,
    "requires_ppu_hil": false,
    "requires_socket_hil": false,
    "requires_physical_programming_success": false,
    "admits_not_verified_physical_state": true
  },
  "physical_validation": {
    "independent_from_catalog_admission": true,
    "ppu_status_is_independent": true,
    "socket_status_is_independent": true,
    "hardware_evidence_required_for_engineering_verified": true
  },
  "execution_policy": {
    "independent_from_catalog_admission": true,
    "catalog_presence_does_not_authorize_target_execution": true,
    "security_sensitive_operations_must_fail_closed_without_required_runtime_evidence": true
  },
  "ui_status_dimensions": [
    "catalog_verification",
    "backend_mapping",
    "ppu_physical_validation",
    "socket_physical_validation"
  ],
  "anti_regression_rules": [
    "Do not delay exact ICPN Production catalog publication solely because PPU HIL is absent.",
    "Do not delay exact ICPN Production catalog publication solely because Socket HIL is absent.",
    "Do not convert catalog admission into a claim of physical programming support.",
    "Do not infer execution authorization from Production catalog membership.",
    "Keep catalog verification, backend mapping, PPU validation, and Socket validation as separate status dimensions."
  ]
}
