<service>
  <id>PlasmaControlStationConsole</id>
  <name>Plasma Control Station</name>
  <description>Plasma operator Console and same-host BFF</description>
  <executable>%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe</executable>
  <arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "%BASE%\run-console.ps1"</arguments>
  <logpath>%ProgramData%\Plasma\logs</logpath>
  <log mode="roll" />
  <stoptimeout>15 sec</stoptimeout>
</service>
