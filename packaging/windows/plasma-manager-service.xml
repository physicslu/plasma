<service>
  <id>PlasmaManager</id>
  <name>Plasma Manager</name>
  <description>Plasma Control Station fleet Manager</description>
  <executable>%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe</executable>
  <arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "%BASE%\run-manager.ps1"</arguments>
  <logpath>%ProgramData%\Plasma\logs</logpath>
  <log mode="roll" />
  <stoptimeout>15 sec</stoptimeout>
</service>
