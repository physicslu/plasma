      },
      "purpose": "establish KL25 family/document scope from explicit section anchors rather than repeated headers"
    },
    "FTFA_MODULE_PRESENCE": {
      "source_ids": ["nxp_kl25_rm_rev3"],
      "terms": ["FTFA", "Flash Memory Module"],
