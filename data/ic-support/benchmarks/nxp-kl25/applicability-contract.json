        "nxp_kl25_ds_rev5": [[20, 21]],
        "nxp_kl25_rm_rev3": [[40, 51], [149, 157]]
      },
      "purpose": "establish debug/programming interface presence from debug-specific sections"
    },
    "MDM_AP_PRESENCE": {
      "source_ids": ["nxp_kl25_rm_rev3"],
      "terms": ["MDM-AP"],
      "page_ranges": {
        "nxp_kl25_rm_rev3": [[149, 157]]
      },
      "purpose": "establish the debug/security access-port model from the dedicated debug chapter"
    },
    "FLASH_SECURITY_MODEL": {
      "source_ids": ["nxp_kl25_rm_rev3"],
      "terms": ["FSEC", "security state"],
      "page_ranges": {
        "nxp_kl25_rm_rev3": [[149, 157], [423, 455]]
      },
