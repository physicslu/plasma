{
  "schema_version": "0.2.0",
  "experiment_id": "stm32f103c-full-vs-evidence-pack-v0",
  "status": "runnable_contract",
  "targets": ["STM32F103C8T6", "STM32F103CBT6"],
  "manufacturer_only_source_ids": ["st_ds5319_rev20", "st_pm0075_rev2"],
  "formal_blind_benchmark": {
    "source_lock_path": "data/ic-support/benchmarks/stm32f103c/source-lock.json",
    "unchanged": true,
    "note": "The formal blind benchmark retains its existing three-source lock and must not be redefined by this A/B experiment."
  },
  "evidence_pack": {
    "policy_path": "data/ic-support/evidence-pack/policies/st-ds5319-rev20-programming-v0.json",
    "builder_path": "data/ic-support/evidence-pack/semantic_pack.py",
    "pack_id": "st-ds5319-rev20-programming-evidence-v0",
    "source_id": "st_ds5319_rev20",
    "generated_files": [
      "structure.json",
      "catalog.json",
      "pack.json",
      "binding.json",
      "bundles/STM32F103C8T6.json",
      "bundles/STM32F103CBT6.json",
      "evidence.txt"
    ],
    "build_command_template": "python data/ic-support/evidence-pack/semantic_pack.py --source-lock data/ic-support/benchmarks/stm32f103c/source-lock.json --policy data/ic-support/evidence-pack/policies/st-ds5319-rev20-programming-v0.json --pdf <locked-ds5319.pdf> --output-dir <outside-repo-output-dir>"
  },
  "arms": {
    "full_context": {
      "datasheet": {
        "mode": "FULL_LOCKED_SOURCE",
        "source_id": "st_ds5319_rev20",
        "text_extraction": "same pdftotext fingerprint used by Evidence Pack generation"
      },
      "programming_manual": "FULL_LOCKED_SOURCE"
    },
    "reduced_context": {
      "datasheet": {
        "mode": "DETERMINISTIC_EVIDENCE_PACK",
        "pack_id": "st-ds5319-rev20-programming-evidence-v0",
        "context_file": "evidence.txt"
      },
      "programming_manual": "FULL_LOCKED_SOURCE"
    }
  },
  "controlled_variables": [
    "model_id",
    "model_runtime",
    "quantization",
    "prompt",
    "target_set",
    "source_revisions",
    "pdftotext_fingerprint",
    "generation_parameters"
  ],
  "metrics": [
    "extraction_accuracy",
    "unsupported_inference_count",
    "missed_required_evidence_count",
    "included_datasheet_pages",
    "datasheet_input_bytes",
    "ttft_ms",
    "total_time_ms",
    "input_tokens",
    "generation_tokens",
    "peak_memory_bytes"
  ],
  "acceptance_principle": "Reduced context must not reduce engineering correctness."
}
