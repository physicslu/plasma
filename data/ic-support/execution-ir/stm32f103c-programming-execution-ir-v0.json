      "requires_authorization": false,
      "continuation": "return",
      "steps": [
        {
          "id": "ensure_unlocked",
          "kind": "ensure_bit_state",
          "register": "FLASH_CR",
          "bit": "LOCK",
          "desired": "clear",
          "when_mismatch": [
            {"kind": "write_register_ref", "register": "FLASH_KEYR", "value_ref": "programming.unlock_keys[0]"},
            {"kind": "write_register_ref", "register": "FLASH_KEYR", "value_ref": "programming.unlock_keys[1]"}
