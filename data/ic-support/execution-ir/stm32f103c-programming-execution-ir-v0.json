{
  "schema_version": "0.1.0",
  "ir_id": "stm32f103c-programming-execution-ir-v0",
  "status": "pilot",
  "profiles": {
    "programming": "stm32f1-medium-density-flash-v0",
    "option": "stm32f1-option-bytes-v0",
    "security": "stm32f1-medium-density-security-v0"
  },
  "targets": [
    {"icpn": "STM32F103C8T6", "memory_geometry_profile": "stm32f103c8-64k-v0"},
    {"icpn": "STM32F103CBT6", "memory_geometry_profile": "stm32f103cb-128k-v0"}
