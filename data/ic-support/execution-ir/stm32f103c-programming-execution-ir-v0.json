        {"id": "inspect_status", "kind": "inspect_status", "register": "FLASH_SR", "error_flags": ["PGERR", "WRPRTERR"], "completion_flag": "EOP", "require_completion": true},
        {"id": "exit_mode", "kind": "exit_mode", "register": "FLASH_CR", "bit": "PG"},
        {"id": "verify", "kind": "verify_memory", "width_source": "programming.program_granularity_bytes", "address_source": "input.address", "value_source": "input.value"}
      ],
      "terminal": {"success_state": "known_idle"}
    },
