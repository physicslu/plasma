        {"id": "enter_mode", "kind": "enter_mode", "register": "FLASH_CR", "bit": "PG"},
        {"id": "write_unit", "kind": "write_memory", "width_source": "programming.program_granularity_bytes", "address_source": "input.address", "value_source": "input.value"},
