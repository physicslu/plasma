        {"id": "enter_mode", "kind": "enter_mode", "register": "FLASH_CR", "bit": "PER"},
        {"id": "set_address", "kind": "write_address_register", "register": "FLASH_AR", "address_source": "input.page_address"},
        {"id": "start", "kind": "set_control_bit", "register": "FLASH_CR", "bit": "STRT"},
