        {"id": "inspect_status", "kind": "inspect_status", "register": "FLASH_SR", "error_flags": ["PGERR", "WRPRTERR"], "completion_flag": "EOP", "require_completion": true},
        {"id": "exit_mode", "kind": "exit_mode", "register": "FLASH_CR", "bit": "PER"},
        {"id": "verify", "kind": "verify_erased", "address_source": "input.page_address", "length_source": "target_geometry.page_size_bytes", "policy": "enabled"}
