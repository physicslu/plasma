      "category": "flash",
      "risk": "destructive",
      "requires_authorization": true,
      "continuation": "return",
      "mode_bit": "MER",
      "steps": [
        {"id": "authorize", "kind": "authorization_barrier", "scope": "mass_erase_main_flash"},
        {"id": "clear_status", "kind": "clear_status_flags", "register": "FLASH_SR", "flags": ["PGERR", "WRPRTERR", "EOP"], "write_semantics": "w1c_explicit"},
        {"id": "enter_mode", "kind": "enter_mode", "register": "FLASH_CR", "bit": "MER"},
        {"id": "start", "kind": "set_control_bit", "register": "FLASH_CR", "bit": "STRT"},
        {"id": "wait_not_busy", "kind": "poll_bit", "register": "FLASH_SR", "bit": "BSY", "expect": "clear", "on_timeout": {"result": "ERR_TIMEOUT", "controller_state": "uncertain", "terminate": true}},
        {"id": "inspect_status", "kind": "inspect_status", "register": "FLASH_SR", "error_flags": ["PGERR", "WRPRTERR"], "completion_flag": "EOP", "require_completion": true},
        {"id": "exit_mode", "kind": "exit_mode", "register": "FLASH_CR", "bit": "MER"}
      ],
      "terminal": {"success_state": "known_idle"}
    },
    {
      "operation_id": "flash_lock",
      "category": "flash",
      "risk": "normal",
      "requires_authorization": false,
      "continuation": "return",
      "steps": [
        {
          "id": "ensure_locked",
          "kind": "ensure_bit_state",
          "register": "FLASH_CR",
          "bit": "LOCK",
          "desired": "set",
          "when_mismatch": [{"kind": "set_control_bit", "register": "FLASH_CR", "bit": "LOCK"}],
          "terminal_observation": {"register": "FLASH_CR", "bit": "LOCK", "expect": "set"}
