{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plasma.local/schemas/socket-design-v1.schema.json",
  "title": "Plasma Socket Design Input v1",
  "description": "Evidence-backed engineering design input. Never grants Socket compatibility, physical programming qualification, or L3.",
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile_id",
        "kind",
        "status",
        "scope",
        "evidence",
        "data"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "kind": {
          "const": "package_hardware"
        },
        "status": {
          "const": "pilot_socket_design_input_ready"
        },
        "scope": {
          "type": "object",
          "minProperties": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "data": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "icpn",
        "profile_id"
      ],
      "properties": {
        "icpn": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "binding_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "binding_set_id",
        "status",
        "bindings"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "binding_set_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "status": {
          "const": "design_input_only"
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/binding"
          }
        }
      }
    }
  }
}
