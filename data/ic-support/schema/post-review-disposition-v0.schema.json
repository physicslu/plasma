{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plasma://ic-support/post-review-disposition-v0",
  "title": "Plasma post-review disposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "source", "dispositions", "artifact_digest"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "artifact_type": {"const": "post_review_disposition"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retained_run_id", "aggregate_digest", "review_view_digest", "qualification_digest", "qualification_status"],
      "properties": {
        "retained_run_id": {"const": "20260909T080946Z"},
        "aggregate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_view_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "qualification_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "qualification_status": {"const": "REJECTED_REVIEW"}
      }
    },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["primary_unit_id", "fact_id", "fact_digest", "action", "projection_state", "rationale", "candidates"],
        "properties": {
          "primary_unit_id": {"type": "string", "minLength": 1},
          "fact_id": {"type": "string", "minLength": 1},
          "fact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "action": {"enum": ["ACCEPT", "REJECT", "REPLACE_WITH_MANUFACTURER_FACT", "SPLIT", "NARROW", "CITATION_SUPPLEMENT_FOR_CANONICAL"]},
          "projection_state": {"enum": ["KNOWLEDGE_ONLY", "CANONICAL_REQUIRED", "EXECUTION_PROFILE_REQUIRED", "BLOCKED"]},
          "rationale": {"type": "string", "minLength": 1},
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate_id", "statement", "evidence", "candidate_digest"],
              "properties": {
                "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
                "statement": {"type": "string", "minLength": 1},
                "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
                "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    },
    "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "pdf_page_number", "source_sha256", "locator"],
      "properties": {
        "source_id": {"enum": ["nxp_kl25_rm_rev3", "nxp_kl25_ds_rev5"]},
        "pdf_page_number": {"type": "integer", "minimum": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "locator": {"type": "string", "minLength": 1}
      }
    }
  }
}
