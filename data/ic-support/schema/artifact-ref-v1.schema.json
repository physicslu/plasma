{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plasma://ic-support/admission/artifact-ref-v1",
  "title": "IC admission artifact reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "artifact_type", "artifact_digest", "schema_id", "schema_version"],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_type": {"type": "string", "minLength": 1},
    "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "minLength": 1}
  }
}
